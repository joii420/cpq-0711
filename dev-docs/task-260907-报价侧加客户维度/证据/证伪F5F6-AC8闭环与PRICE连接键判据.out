BEGIN
CREATE FUNCTION
                                       f5                                        
---------------------------------------------------------------------------------
 [F5] 改动前函数下 ds_独有料号的非空单价行数=0（必须 0，否则闭环判据本来就恒真）
(1 row)

                          f5b                          
-------------------------------------------------------
 [F5 阳性对照] 改动后函数下同一判据行数=20（必须 > 0）
(1 row)

ROLLBACK
BEGIN
                  before_f6                  
---------------------------------------------
 [F6 干预前] 连接键=element_code+material_no
(1 row)

DELETE 1
                       after_f6                        
-------------------------------------------------------
 [F6 干预后] 连接键条数=1（判据要求 2 ⇒ 此时断言必红）
(1 row)

ROLLBACK
              after_rollback              
------------------------------------------
 [F6 回滚自证] 连接键条数=2（必须回到 2）
(1 row)

