e":"零件材料成本","expression":[{"type":"bracket_open"},{"type":"bracket_open"},{"agg":"SUM","dir":"CHILD","type":"tree_ref","targetExpr":[{"type":"field","value":"材料成本"}]},{"type":"operator","value":"+"},{"agg":"SUM","dir":"CHILD","type":"tree_ref","targetExpr":[{"type":"field","value":"材料损耗成本"}]},{"type":"bracket_close"},{"type":"operator","value":"*"},{"type":"bracket_open"},{"type":"field","value":"来料回收费"},{"type":"operator","value":"+"},{"type":"field","value":"来料财务费"},{"type":"bracket_close"},{"type":"operator","value":"/"},{"type":"number","value":"100"},{"type":"bracket_close"},{"type":"operator","value":"+"},{"type":"component_subtotal","label":"来料固定加工费·加工费","value":"加工费","tab_name":"COMP-0004","component_code":"COMP-0004"},{"type":"operator","value":"*"},{"type":"field","value":"材料净重"},{"type":"operator","value":"*"},{"type":"field","value":"组成数量"}],"result_type":"NUMBER"},{"id":"f-1789460389573-ksvip9v1","name":"银点粉体类材料成本公式","expression":[{"type":"bracket_open"},{"type":"bracket_open"},{"type":"field","value":"材料占比"},{"type":"operator","value":"/"},{"type":"number","value":"100"},{"type":"bracket_close"},{"type":"operator","value":"*"},{"type":"bracket_open"},{"agg":"SUM","type":"cross_tab_ref","match":[{"a":"销售料号","b":"销售料号"},{"a":"料号","b":"料号"}],"source":"3aeb3cca-84dc-4626-9097-7c46a8fdbd47","target":"","targetExpr":[{"type":"field","value":"组成含量（%）","source":"3aeb3cca-84dc-4626-9097-7c46a8fdbd47"},{"type":"operator","value":"/"},{"type":"number","value":"100"},{"type":"operator","value":"*"},{"type":"field","value":"税后单价","source":"3aeb3cca-84dc-4626-9097-7c46a8fdbd47"},{"type":"operator","value":"*"},{"type":"bracket_open"},{"type":"number","value":"1"},{"type":"operator","value":"+"},{"type":"b_field","value":"来料损耗率"},{"type":"operator","value":"/"},{"type":"number","value":"100"},{"type":"bracket_close"},{"type":"operator","value":"+"},{"type":"b_field","value":"来料加工费"}],"sourceLabel":"材料成本"},{"type":"bracket_close"},{"type":"bracket_close"},{"type":"operator","value":"*"},{"type":"field","value":"材料净重"},{"type":"operator","value":"*"},{"type":"field","value":"组成数量"}],"result_type":"NUMBER"}],"excelColumns":[],"sqlViews":[{"sqlViewName":"builder_aecf34a08407","sqlTemplate":"-- 树契约: material_no=子 / parent_no=父 + :total_material_no; 边式全子件 + 根分支\nSELECT\n  dqmb.input_material_no AS material_no,\n  dqmb.material_no AS parent_no,\n  dqmb.input_material_no AS hf_part_no,\n  dqmb.material_no AS \"_物料BOM_销售料号\",\n  dqmb.input_material_no AS \"_物料BOM_投入料号\",\n  COALESCE(dqm.material_name, mr.symbol) AS \"_物料_材料名\",\n  dqmb.output_material_type AS \"_物料BOM_产出料号类型\",\n  dqmb.component_qty AS \"_物料BOM_组成数量\",\n  dqmb.gross_weight AS \"_物料BOM_材料毛重\",\n  dqmb.net_weight AS \"_物料BOM_材料净重\",\n  dqmb.weight_unit AS \"_物料BOM_重量单位\",\n  dqmb.material_ratio AS \"_物料BOM_材料占比（%）\",\n  dqmb.loss_rate AS \"_物料BOM_损耗率（%）\"\nFROM ds_quote_material_bom dqmb\n  LEFT JOIN ds_quote_material dqm ON dqm.material_no = dqmb.input_material_no AND dqm.customer_no = dqmb.customer_no\n  LEFT JOIN material_recipe mr ON mr.code = dqmb.input_material_no\nWHERE dqmb.input_material_no = ANY(:total_material_no) AND dqmb.customer_no = :customerCode\nUNION ALL\n-- 根分支：本单闭包里无父边的成品自身（树根，parent_no 恒 NULL）\nSELECT\n  dqm2.material_no,\n  NULL::text,\n  dqm2.material_no,\n  NULL,\n  NULL,\n  NULL,\n  NULL,\n  NULL,\n  NULL,\n  NULL,\n  NULL,\n  NULL,\n  NULL\nFROM ds_quote_material dqm2\nWHERE dqm2.material_no = ANY(:total_material_no) AND dqm2.customer_no = :customerCode\n  AND NOT EXISTS (SELECT 1 FROM ds_quote_material_bom dqmb2 WHERE dqmb2.input_material_no = dqm2.material_no AND dqmb2.customer_no = dqm2.customer_no)\nORDER BY parent_no, material_no","declaredColumns":[{"name":"material_no","dataType":"varchar","nullable":true},{"name":"parent_no","dataType":"varchar","nullable":true},{"name":"hf_part_no","dataType":"varchar","nullable":true},{"name":"_物料BOM_销售料号","dataType":"varchar","nullable":true},{"name":"_物料BOM_投入料号","dataType":"varchar","nullable":true},{"name":"_物料_材料名","dataType":"varchar","nullable":true},{"name":"_物料BOM_产出料号类型","dataType":"varchar","nullable":true},{"name":"_物料BOM_组成数量","dataType":"numeric","nullable":true},{"name":"_物料BOM_材料毛重","dataType":"numeric","nullable":true},{"name":"_物料BOM_材料净重","dataType":"numeric","nullable":true},{"name":"_物料BOM_重量单位","dataType":"varchar","nullable":true},{"name":"_物料BOM_材料占比（%）","dataType":"numeric","nullable":true},{"name":"_物料BOM_损耗率（%）","dataType":"numeric","nullable":true}],"requiredVariables":["total_material_no","customerCode"],"scope":"COMPONENT","description":null}]}],"dependencies":{"globalVariables":[],"datasources":[]},"checksum":"sha256:5faa1c9cc4489858ce4f0dd3a8a4c25eb857e100e8b6bf82c15b97f82d9ecdfb","bindingReport":{"unboundCount":0,"totalFormulaRefs":14,"items":[{"componentCode":"COMP-0003","componentName":"材料成本","fieldName":"税后单价 › 规则1","resolvedFormulaId":"f-1789460491524-o9gyn0ok","resolvedFormulaName":"不扣税单价公式","status":"BOUND","message":null},{"componentCode":"COMP-0003","componentName":"材料成本","fieldName":"税后单价 › 默认","resolvedFormulaId":"f-1789459297841-u8b87au4","resolvedFormulaName":"税后单价公式","status":"BOUND","message":null},{"componentCode":"COMP-0001","componentName":"产品","fieldName":"管理费","resolvedFormulaId":"f-1789459337944-6sbm3tma","resolvedFormulaName":"管理费","status":"BOUND","message":null},{"componentCode":"COMP-0002","componentName":"物料","fieldName":"来料回收费","resolvedFormulaId":"f-1789459501800-b7u5uy44","resolvedFormulaName":"来料回收费取值公式","status":"BOUND","message":null},{"componentCode":"COMP-0002","componentName":"物料","fieldName":"来料财务费","resolvedFormulaId":"f-1789459589040-hbsocbhx","resolvedFormulaName":"来料财务费取值公式","status":"BOUND","message":null},{"componentCode":"COMP-0002","componentName":"物料","fieldName":"材料成本 › 规则1","resolvedFormulaId":"f-1789460341477-uo8pwvm7","resolvedFormulaName":"非银点类材料成本公式","status":"BOUND","message":null},{"componentCode":"COMP-0002","componentName":"物料","fieldName":"材料成本 › 规则2","resolvedFormulaId":"f-178