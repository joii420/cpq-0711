ate AS \"_客户料号关系_汇率\"\nFROM material_master mm\n  JOIN material_customer_map mcm ON mcm.material_no = mm.material_no AND mcm.customer_no = :customerCode\n  LEFT JOIN material_customer_map mcm2 ON mcm2.material_no = mm.material_no AND mcm2.customer_no = :customerCode\nORDER BY mm.material_no","declared_columns":[{"name": "hf_part_no", "dataType": "varchar", "nullable": false}, {"name": "_主档_销售料号", "dataType": "varchar", "nullable": false}, {"name": "_客户料号关系_客户料号名称", "dataType": "varchar", "nullable": true}, {"name": "_客户料号关系_客户产品编号", "dataType": "varchar", "nullable": true}, {"name": "_主档_标准单位", "dataType": "varchar", "nullable": true}, {"name": "_客户料号关系_汇率", "dataType": "numeric", "nullable": true}],"required_variables":["customerCode"],"scope":"COMPONENT","status":"ACTIVE","description":null,"created_by":"d1e1147c-a639-4156-aeac-9f938a65ad05","created_at":"2026-08-21T18:51:28.897715","updated_at":"2026-08-21T22:41:17.485238","builder_config":{"columns": [{"isAmount": null, "fieldName": "销售料号", "fieldType": null, "inSubtotal": null, "viewColumn": "_主档_销售料号", "sourceColumn": "material_no", "resolvedRoles": ["PART_NO", "ROW_KEY"], "sourceNodeKey": "PRODUCT_MASTER", "resolvedDataType": "TEXT"}, {"isAmount": null, "fieldName": "客户料号名称", "fieldType": null, "inSubtotal": null, "viewColumn": "_客户料号关系_客户料号名称", "sourceColumn": "customer_material_name", "resolvedRoles": ["PART_NAME"], "sourceNodeKey": "LOOKUP_CUSTOMER_MAP", "resolvedDataType": "TEXT"}, {"isAmount": null, "fieldName": "客户产品编号", "fieldType": null, "inSubtotal": null, "viewColumn": "_客户料号关系_客户产品编号", "sourceColumn": "customer_product_no", "resolvedRoles": [], "sourceNodeKey": "LOOKUP_CUSTOMER_MAP", "resolvedDataType": "TEXT"}, {"isAmount": null, "fieldName": "单位", "fieldType": null, "inSubtotal": null, "viewColumn": "_主档_标准单位", "sourceColumn": "standard_unit", "resolvedRoles": [], "sourceNodeKey": "PRODUCT_MASTER", "resolvedDataType": "TEXT"}, {"isAmount": null, "fieldName": "汇率", "fieldType": null, "inSubtotal":