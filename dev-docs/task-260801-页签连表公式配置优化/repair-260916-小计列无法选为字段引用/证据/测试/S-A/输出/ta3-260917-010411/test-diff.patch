+    expect(check('SUMIF([RP0916加工费.备注数] > 0, [RP0916加工费.加工费(小计)])'))
+      .toBe('Excel 列暂不支持 SUMIF 类函数（SUMIF / COUNTIF / AVGIF / MINIF / MAXIF）');
+  });
+});
