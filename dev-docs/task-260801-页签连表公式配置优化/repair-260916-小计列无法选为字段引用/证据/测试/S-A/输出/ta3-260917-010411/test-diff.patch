+  });
+
+  it('未知页签的 (小计) → 沿用现有未知页签报错', () => {
+    expect(check('[不存在.加工费(小计)]')).toMatch(/未知页签 "不存在"/);
+  });
+
+  it('AC-18⑤ SUMIF 类函数（任意大小写、含空格）→ 专用文案；方括号内同名文字不算', () => {
+    const msg = 'Excel 列暂不支持 SUMIF 类函数（SUMIF / COUNTIF / AVGIF / MINIF / MAXIF）';
