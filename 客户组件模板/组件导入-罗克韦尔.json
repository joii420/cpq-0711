      "sqlViews": [
        {
          "sqlViewName": "mc_view",
          "sqlTemplate": "-- 材料成本(材质元素, 平铺契约; 材质逐行取本行 material_part_no; 元素单价接客户价格策略)\nSELECT\n  ebi.material_no AS hf_part_no,\n  ebi.material_no AS _销售料号,\n  COALESCE(mr.name, mm2.material_name) AS _材质,\n  ebi.seq_no AS _项次,\n  ebi.component_no AS _元素,\n  ebi.content AS _组成含量,\n  ebi.scrap_rate AS _损耗率,\n  ebi.composition_qty AS _毛重,\n  ebi.issue_unit AS _毛用量单位,\n  cep.unit_price AS 元素单价\nFROM element_bom_item ebi\n  LEFT JOIN material_recipe mr  ON mr.code = ebi.material_part_no\n  LEFT JOIN material_master mm2 ON mm2.material_no = ebi.material_part_no\n  LEFT JOIN f_customer_element_price(:customerCode, :priceBaseDate) cep\n         ON cep.element_code = ebi.component_no\nWHERE ebi.system_type = 'QUOTE' AND ebi.is_current AND ebi.customer_no = :customerCode\nORDER BY ebi.material_no, ebi.material_part_no, ebi.seq_no",
          "declaredColumns": [
            {
              "name": "hf_part_no",
              "dataType": "varchar",
              "nullable": false
            },
            {
              "name": "_销售料号",
              "dataType": "varchar",
              "nullable": false
            },
            {
              "name": "_材质",
              "dataType": "varchar",
              "nullable": true
            },
            {
              "name": "_项次",
              "dataType": "int4",
              "nullable": true
            },
            {
              "name": "_元素",
              "dataType": "varchar",
              "nullable": true
            },
            {
