          "basic_data_path": "$wl_ys_bom_view.元素单价"
        }
      ],
      "formulas": [],
      "excelColumns": [],
      "sqlViews": [
        {
          "sqlViewName": "wl_ys_bom_view",
          "sqlTemplate": "with recursive bom_closure as (\n  select distinct b.material_no as root_no, b.material_no as node_no, 0 as lvl\n  from material_bom_item b\n  where b.system_type = 'PRICING' and b.is_current and b.customer_no = '_GLOBAL_'\n  union all\n  select c.root_no, b.component_no, c.lvl + 1\n  from bom_closure c\n    join material_bom_item b on b.material_no = c.node_no\n  where b.system_type = 'PRICING' and b.is_current and b.customer_no = '_GLOBAL_'\n    and c.lvl < 10\n)\nselect\n  ebi.material_no        as material_no,\n  ebi.material_no        as hf_part_no,\n  ebi.material_part_no   as material_part_no,\n  ebi.seq_no             as seq_no,\n  ebi.component_no       as component_no,\n  ebi.content            as content,\n  ebi.scrap_rate         as scrap_rate,\n  cep.unit_price         as 元素单价\nfrom element_bom_item ebi\nleft join lateral (\n  select root_no from bom_closure where node_no = ebi.material_no\n  order by (case when lvl = 0 then 1 else 0 end) asc, lvl asc, root_no asc limit 1\n) cl on true\nleft join f_material_element_price(:customerCode, :priceBaseDate) cep\n       on cep.element_code = ebi.component_no\n      and cep.material_no  = coalesce(cl.root_no, ebi.material_no)\nwhere ebi.system_type = 'PRICING'\n  and ebi.is_current = true\n  and ebi.material_no = ANY(:total_material_no)\norder by ebi.seq_no\n",
          "declaredColumns": [
            {
              "name": "material_no",
              "dataType": "varchar",
              "nullable": false
            },
            {
              "name": "hf_part_no",
              "dataType": "varchar",
              "nullable": false
            },
            {
              "name": "material_part_no",
              "dataType": "varchar",
              "nullable": true
            },
            {
              "name": "seq_no",
              "dataType": "int4",
              "nullable": true
            },
            {
              "name": "component_no",
              "dataType": "varchar",
              "nullable": true
            },
            {
              "name": "content",
              "dataType": "numeric",
              "nullable": true
            },
            {
              "name": "scrap_rate",
              "dataType": "numeric",
              "nullable": true
            },
            {
              "name": "元素单价",
              "dataType": "numeric",
              "nullable": true
            }
          ],
          "requiredVariables": [
            "customerCode",
            "priceBaseDate",
            "total_material_no"
          ],
          "scope": "COMPONENT",
          "description": null
        }
      ]
    },
