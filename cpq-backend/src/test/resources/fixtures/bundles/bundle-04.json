      "sqlViews": [
        {
          "sqlViewName": "qt_view",
          "sqlTemplate": "-- 其他费用（成品其他费用；price_type='FINISHED_MATERIAL_OTHER'；料号在 code 列）\n-- 本页签是「本成品自身的费用项」→ 不做 BOM 闭包（§3.8.1 判据）。\n-- ⚠️ 现网口径：固定金额项写 pricing_price，按比例登记的项（材料管理费/利润/税率…）值在 cost_ratio、\n--    pricing_price 为空 —— 故「费用」「比例」两列并存，各取各的，不互相兜底。\nSELECT\n  up.code AS hf_part_no,\n  up.code AS _销售料号,\n  up.seq_no AS _项次,\n  up.cost_type AS _要素,\n  up.pricing_price AS _费用,\n  up.cost_ratio AS _比例,\n  up.unit AS _单位\nFROM unit_price up\nWHERE up.system_type = 'QUOTE' AND up.price_type = 'FINISHED_MATERIAL_OTHER' AND up.is_current = true\n  AND up.customer_no = :customerCode\nORDER BY up.seq_no",
          "declaredColumns": [
            {
              "name": "hf_part_no",
              "dataType": "varchar",
              "nullable": false
            },
            {
              "name": "_销售料号",
              "dataType": "varchar",
              "nullable": false
            },
            {
              "name": "_项次",
              "dataType": "int4",
              "nullable": true
            },
            {
              "name": "_要素",
              "dataType": "varchar",
              "nullable": true
            },
            {
              "name": "_费用",
              "dataType": "numeric",
              "nullable": true
            },
            {
              "name": "_比例",
              "dataType": "numeric",
              "nullable": true
            },
            {
              "name": "_单位",
              "dataType": "varchar",
              "nullable": true
            }
          ],
          "requiredVariables": [
            "customerCode"
          ],
          "scope": "COMPONENT",
          "description": null
        }
      ]
    }
