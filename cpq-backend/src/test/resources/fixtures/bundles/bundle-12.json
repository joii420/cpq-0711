      "sqlViews": [
        {
          "sqlViewName": "zz_view",
          "sqlTemplate": "-- 组装加工费（主件=成品自身的组装工序；源 capacity，QUOTE 口径）\n-- capacity 无 customer_no 列 → 不加 :customerCode 过滤，靠 hf_part_no=material_no 按本行成品收窄。\n-- 本页签是「产品自身的组装工序」→ 不做 BOM 闭包（§3.8.1 判据）。\n-- 现网工序名常写在 process_no（process_name 空）→ 工序绑 COALESCE(NULLIF(process_name,''), process_no)。\nSELECT\n  c.material_no AS hf_part_no,\n  c.material_no AS _销售料号,\n  COALESCE(mm.material_name, mr.name) AS _料件,\n  c.seq_no AS _项次,\n  COALESCE(NULLIF(c.process_name, ''), c.process_no) AS _工序,\n  c.fixed_cost AS _加工费,\n  c.capacity_unit AS _单位,\n  c.default_defect_rate AS _不良率\nFROM capacity c\n  LEFT JOIN material_master mm ON mm.material_no = c.material_no\n  LEFT JOIN material_recipe mr ON mr.code = c.material_no\nWHERE c.system_type = 'QUOTE' AND c.is_current\nORDER BY c.seq_no",
          "declaredColumns": [
            {
              "name": "hf_part_no",
              "dataType": "varchar",
              "nullable": false
            },
            {
              "name": "_销售料号",
              "dataType": "varchar",
              "nullable": false
            },
            {
              "name": "_料件",
              "dataType": "varchar",
              "nullable": true
            },
