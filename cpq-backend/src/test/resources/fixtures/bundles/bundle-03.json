      "sqlViews": [
        {
          "sqlViewName": "cp_view",
          "sqlTemplate": "-- 产品（主件，平铺契约：hf_part_no + :customerCode）\n-- 本页签展示「产品自身属性」→ 按 §3.8.1 判据【不做 BOM 闭包】，否则会串入子件信息。\n-- 「税率」无源手填，故本视图不输出该列（§6 自检 0：视图输出列与字段一一对应，无没人绑的死列）。\nSELECT\n  mm.material_no AS hf_part_no,\n  mm.material_no AS _销售料号,\n  mcm.customer_material_name AS _客户料号名称,\n  mcm.customer_product_no AS _客户产品编号,\n  mcm.quote_currency AS _报价货币\nFROM material_master mm\nLEFT JOIN material_customer_map mcm\n  ON mcm.material_no = mm.material_no AND mcm.customer_no = :customerCode",
          "declaredColumns": [
            {
              "name": "hf_part_no",
              "dataType": "varchar",
              "nullable": false
            },
            {
              "name": "_销售料号",
              "dataType": "varchar",
              "nullable": false
            },
            {
              "name": "_客户料号名称",
              "dataType": "varchar",
              "nullable": true
            },
            {
              "name": "_客户产品编号",
              "dataType": "varchar",
              "nullable": true
            },
            {
              "name": "_报价货币",
              "dataType": "varchar",
              "nullable": true
            }
          ],
          "requiredVariables": [
            "customerCode"
          ],
          "scope": "COMPONENT",
          "description": null
        }
      ]
